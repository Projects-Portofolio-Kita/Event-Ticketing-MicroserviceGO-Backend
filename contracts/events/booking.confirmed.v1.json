{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/events/booking.confirmed.v1.json",
  "title": "booking.confirmed.v1",
  "description": "Diterbitkan saat reservasi dikonfirmasi (status LOCKED -> CONFIRMED). Kontrak integrasi berikutnya — message broker belum aktif, saat ini booking dipanggil langsung via HTTP oleh payment-service.",
  "type": "object",
  "required": ["eventId", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Nama event pada broker (bukan domain event/id UUID), mis. \"booking.confirmed.v1\".",
      "minLength": 1,
      "examples": ["booking.confirmed.v1"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu UTC saat fakta bisnis terjadi (RFC 3339)."
    },
    "producer": {
      "type": "string",
      "description": "Service pembuat event.",
      "enum": ["booking-service"]
    },
    "payload": {
      "type": "object",
      "required": [
        "reservationId",
        "userId",
        "eventId",
        "bookingRef",
        "seats",
        "totalAmount",
        "currency"
      ],
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "ID event katalog (bukan nama event broker)."
        },
        "bookingRef": {
          "type": "string",
          "examples": ["TICK-1735689600-0421"]
        },
        "seats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["seatId", "section", "row", "number", "price"],
            "properties": {
              "seatId": { "type": "string", "format": "uuid" },
              "section": { "type": "string" },
              "row": { "type": "string" },
              "number": { "type": "string" },
              "price": { "type": "number" }
            }
          }
        },
        "totalAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "examples": ["IDR"]
        }
      }
    }
  }
}
