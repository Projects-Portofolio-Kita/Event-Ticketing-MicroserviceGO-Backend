SERVER_PORT=8081
DATABASE_URL=postgres://username:password@localhost:5432/event_ticketing_db?sslmode=disable

# HS256 signing secret for access JWTs. Generate a strong random value:
#   openssl rand -hex 32
# MUST be overridden in production (see backend/docker-compose.yml).
JWT_SECRET=change-me-dev-only-not-for-production

# Access token lifetime in minutes (default 15) and refresh lifetime in
# minutes (default 10080 = 7 days).
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080

# Google OAuth client ID (same value as the web portal's VITE_GOOGLE_CLIENT_ID).
# Required for POST /api/v1/auth/google; empty disables Google login (503).
GOOGLE_CLIENT_ID=
