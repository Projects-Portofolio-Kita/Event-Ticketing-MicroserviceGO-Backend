SERVER_PORT=8083
DATABASE_URL=postgres://admin:tiketid@localhost:5432/event_ticketing_db?sslmode=disable
# Must be the same value auth-service signs its access tokens with.
JWT_SECRET=dev-only-insecure-secret-change-in-production-0123456789abcdef
# Shared X-Service-Token used by payment-service to call this service.
SERVICE_TOKEN=dev-only-internal-service-token-change-in-production-9f3a7c21
# Empty disables notifications (fire-and-forget, never blocks a booking).
NOTIFICATION_SERVICE_URL=http://localhost:8085
