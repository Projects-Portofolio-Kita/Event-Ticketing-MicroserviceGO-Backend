# Build context is the backend/ root (see docker-compose.yml). libs/common is
# a local Go module referenced through a `replace` directive in go.mod, so it
# has to be inside the build context as well.
FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY libs/ ./libs/
COPY services/notification-service/go.mod services/notification-service/go.sum ./services/notification-service/
RUN cd services/notification-service && go mod download

COPY services/notification-service/ ./services/notification-service/
RUN cd services/notification-service && CGO_ENABLED=0 GOOS=linux go build -o /app/server ./cmd/server

FROM alpine:3.19

RUN apk --no-cache add ca-certificates

WORKDIR /root/
COPY --from=builder /app/server .

EXPOSE 8085

CMD ["./server"]