SERVER_PORT=8085
DATABASE_URL=postgres://admin:tiketid@localhost:5432/event_ticketing_db?sslmode=disable
# Must be the same value auth-service signs its access tokens with; it guards
# GET /notifications and POST /notifications/:id/read.
JWT_SECRET=dev-only-insecure-secret-change-in-production-0123456789abcdef
# Only requests carrying this X-Service-Token may POST a notification.
SERVICE_TOKEN=dev-only-internal-service-token-change-in-production-9f3a7c21
