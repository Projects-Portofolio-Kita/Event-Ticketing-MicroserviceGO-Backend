# ==============================================================================
# TickId Notification Service — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment:
#   cp .env.example .env
#
# Supported Environments:
#   1. Production / Staging: Gmail SMTP (Free Personal Google Account with App Password)
#   2. Local Development: Mailpit Docker Container (Zero-cost offline mail catcher)
# ==============================================================================

# ------------------------------------------------------------------------------
# HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Notification Service listens for incoming HTTP requests.
# Default: 8085
SERVER_PORT=8085

# ------------------------------------------------------------------------------
# Worker Pool & Asynchronous Queue Settings
# ------------------------------------------------------------------------------
# Number of concurrent worker goroutines processing outbound email jobs.
# Default: 5
WORKER_COUNT=5

# Maximum capacity of the buffered in-memory job channel before backpressure (503).
# Default: 500
QUEUE_CAPACITY=500

# ==============================================================================
# SMTP CONFIGURATION 1: Free Gmail SMTP (Google App Password)
# ==============================================================================
# Google allows personal Gmail accounts to send up to 500 free transactional
# emails per day using a standard SMTP connection and a 16-character App Password.
#
# ==============================================================================
# 9-STEP TUTORIAL: GENERATING A FREE GOOGLE APP PASSWORD
# ==============================================================================
# 1. Log in to your personal Google Account at https://myaccount.google.com/
# 2. In the left-hand navigation menu, click on "Security" (Keamanan).
# 3. Under the "How you sign in to Google" section, confirm that "2-Step Verification"
#    (Verifikasi 2 Langkah) is turned ON.
#    * Note: Google strictly requires 2-Step Verification before enabling App Passwords.
#      If it is OFF, click it and follow the prompts to enable it via SMS or Authenticator.
# 4. Once 2-Step Verification is active, click on "2-Step Verification" and scroll down
#    to the very bottom of the page to find "App passwords" (Sandi aplikasi).
#    * Direct Link: https://myaccount.google.com/apppasswords
#    * Alternatively, type "App Passwords" into the search bar at the top of Google Account.
# 5. When prompted, re-enter your Google account password to verify your identity.
# 6. In the "App name" input field, type an application name, e.g.:
#      "TickId Notification Service"
# 7. Click the "Create" (Buat) button.
# 8. A pop-up dialog will appear with a yellow-highlighted 16-character password
#    (e.g., "abcd efgh ijkl mnop").
#    * COPY THIS PASSWORD IMMEDIATELY. Remove the spaces so it forms a continuous
#      16-character string: "abcdefghijklmnop".
#    * Google will never show this password again after you click "Done".
# 9. Paste the copied 16-character string into SMTP_PASS below, and set your Gmail address
#    in SMTP_USER and SMTP_FROM.
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=TickId Official
SMTP_USE_TLS=true

# ==============================================================================
# SMTP CONFIGURATION 2: Local Development with Mailpit (Docker)
# ==============================================================================
# For local visual email inspection without sending real emails over the internet,
# use Mailpit (https://github.com/axllent/mailpit).
#
# To start Mailpit in Docker, run:
#   docker run -d --name tickid-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#
# Then uncomment the settings below and comment out the Gmail SMTP settings above:
#
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@tickid.com
# SMTP_FROM_NAME=TickId Local Dev
# SMTP_USE_TLS=false
#
# View captured emails, HTML rendering, and PDF attachments in your browser:
#   http://localhost:8025
# ==============================================================================
