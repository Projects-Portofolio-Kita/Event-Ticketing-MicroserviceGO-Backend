# Build context is the backend/ root (see docker-compose.yml). libs/common is
# a local Go module referenced through a `replace` directive in go.mod, so it
# has to be inside the build context as well.
FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY libs/ ./libs/
COPY gateway/go.mod gateway/go.sum ./gateway/
RUN cd gateway && go mod download

COPY gateway/ ./gateway/
RUN cd gateway && CGO_ENABLED=0 GOOS=linux go build -o /app/server ./cmd/server

FROM alpine:3.19

RUN apk --no-cache add ca-certificates

WORKDIR /root/
COPY --from=builder /app/server .

EXPOSE 8080

CMD ["./server"]